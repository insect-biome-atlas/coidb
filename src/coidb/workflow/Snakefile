import polars as pl
import pandas as pd
import string
import gzip as gz
from tempfile import NamedTemporaryFile
from snakemake.utils import validate
import os
import sys

# set default compute account when account is None
if config["account"] is None:
    config["account"] = "None"


pathvars:
    results=config["output_dir"],
    temp_dir=config["temp_dir"],
    logs=os.path.join(config["output_dir"], "_logs"),


localrules:
    extract_input,
    gzip,
    collect_vsearch,


wildcard_constraints:
    n="gbif|coidb",
    suffix="tsv|fasta",
    format="sintax|dada2.toGenus|dada2.toSpecies|dada2.addSpecies",
    consensus_type="coidb|gbif",
    tool="sintax|dada2",
    s="inclNA|exclNA",


def all_input(wildcards):
    consensus_type = ["coidb", "gbif"] if config["gbif_backbone"] else ["coidb"]
    input = ["<results>/coidb/coidb.info.tsv.gz", "<results>/input_timestamp.txt"]
    input += expand(
        "<results>/stats/{stats_type}.tsv",
        stats_type=["general_stats", "taxa_stats"],
    )
    input += expand(
        "<results>/consensus_taxonomy/{consensus_type}.{s}.tsv.gz",
        consensus_type=consensus_type,
        s=["exclNA", "inclNA"],
    )
    input += expand(
        "<results>/dada2/{consensus_type}.{format}.{s}.fasta.gz",
        consensus_type=consensus_type,
        format=["dada2.toGenus", "dada2.toSpecies", "dada2.addSpecies"],
        s=["exclNA", "inclNA"],
    )
    input += expand(
        "<results>/sintax/{consensus_type}.sintax.{s}.fasta.gz",
        consensus_type=consensus_type,
        s=["exclNA", "inclNA"],
    )
    input += expand(
        "<results>/qiime2/{consensus_type}.qiime2.info.{s}.tsv.gz",
        consensus_type=consensus_type,
        s=["exclNA", "inclNA"],
    )
    return input


rule all:
    input:
        all_input,


rule gzip:
    input:
        "{f}.{suffix}",
    output:
        "{f}.{suffix}.gz",
    message:
        "Compressing {wildcards.f}.{wildcards.suffix}"
    shell:
        """
        gzip -c {input} > {output}
        """


# This checkpoint extracts the input tarball (if specified).
checkpoint extract_input:
    input:
        tarball=config["input_file"],
    output:
        directory(os.path.join(config["temp_dir"], "_extract")),
    log:
        "<logs>/extract_input.log",
    message:
        "Extracting input file {config[input_file]}"
    shell:
        """
        rm -rf {output}
        mkdir -p {output}
        tar -C {output} -xvf {input.tarball} > {log} 2>&1
        """


def get_extracted(wildcards):
    """
    This function identifies the filename of the *.tsv file contained in the
    input tarball.
    """
    if config["input_file"].endswith(".tar.gz"):
        checkpoint_output = checkpoints.extract_input.get(**wildcards).output[0]
        tsv = expand(
            "{temp_dir}/_extract/{f}.tsv",
            f=glob_wildcards(os.path.join(checkpoint_output, "{f}.tsv")).f,
            temp_dir=config["temp_dir"],
        )
    elif config["input_file"].endswith(".tsv"):
        tsv = config["input_file"]
    return tsv


# This rule filters the input data by:
# 1. Selecting a subset of columns
# 2. Only keeping records matching COI-5P as 'marker_code'
# 3. Only keeping records with an assigned BOLD BIN
# 4. Only keeping records with a sequence length >= min_len (default 500)
# 5. Strips leading and trailing '-' characters
# 6. Removes sequences with with remaining gaps
# 7. Removes sequences with non DNA characters
# For prokaryotic records lines are kept in step 3 even if no BOLD BIN is
# assigned.
rule filter:
    input:
        tsv=get_extracted,
    output:
        tsv=temp("<temp_dir>/_processed/data.filtered.tsv"),
        timestamp=temp("<results>/input_timestamp.txt"),
    log:
        "<logs>/filter.log",
    threads: 4
    resources:
        slurm_account=config["account"],
    params:
        min_len=config["min_len"],
        input_file=config["input_file"],
    message:
        "Filter data to only include BOLD BIN records, trim and remove spurious sequences"
    shell:
        """
        export POLARS_MAX_THREADS={threads}
        echo "Input data:" >> {output.timestamp}
        echo "  - filename: {params.input_file}" >> {output.timestamp}
        echo "  - extracted filename: {input.tsv}" >> {output.timestamp}
        filter-records -i {input.tsv} -o {output.tsv} -l {params.min_len} 2>{log}
        """


# This rules matches species names from BOLD to species names in Catalog of Life
rule gbif_match:
    input:
        tsv=rules.filter.output.tsv,
    output:
        tsv=temp("<temp_dir>/gbif/species-matched.tsv"),
        tsv_unrefined=temp("<temp_dir>/gbif/species-matched.raw.tsv"),
    log:
        "<logs>/gbif_match.log",
    threads: 4
    resources:
        slurm_account=config["account"],
    message:
        "Matching BOLD species names to GBIF"
    shell:
        """
        export POLARS_MAX_THREADS={threads}
        match-names -i {input.tsv} -c species -p {threads} --unrefined_out {output.tsv_unrefined} -o {output.tsv} > {log} 2>&1
        """


def fill_missing_input(wildcards):
    if wildcards.n == "coidb":
        return rules.filter.output.tsv
    elif wildcards.n == "gbif":
        return rules.gbif_match.output.tsv


# This rule fills in missing ranks in taxonomic dataframes.
rule fill_missing:
    input:
        fill_missing_input,
    output:
        tsv=temp("<temp_dir>/{n}/{n}.info.fill-missing.tsv"),
    log:
        "<logs>/fill_missing.{n}.log",
    threads: 4
    resources:
        slurm_account=config["account"],
    message:
        "Filling missing ranks for {wildcards.n} data"
    shell:
        """
        export POLARS_MAX_THREADS={threads}
        fill-missing -i {input} -o {output.tsv} 2>{log}
        """


# This rule identifies non-unique lineages and fixes these by prefixing taxa
# with parent ranks.
rule fix_nonunique:
    input:
        tsv=rules.fill_missing.output.tsv,
    output:
        tsv=temp("<results>/{n}/{n}.info.tsv"),
    log:
        "<logs>/fix_nonunique.{n}.log",
    threads: 4
    resources:
        slurm_account=config["account"],
    params:
        id_col=lambda wildcards: "name" if wildcards.n == "gbif" else "bin_uri",
    message:
        "Fixing non-unique lineages for {wildcards.n}"
    shell:
        """
        export POLARS_MAX_THREADS={threads}
        fix-nonunique-lineages -i {input.tsv} --id_col {params.id_col} -o {output.tsv} 2>{log}
        """


# Update names in coidb.info.tsv based on matched species names in Catalog of
# Life.
rule consolidate_names:
    input:
        coidb="<results>/coidb/coidb.info.tsv.gz",
        gbif="<results>/gbif/gbif.info.tsv.gz",
    output:
        tsv="<results>/consolidated/{filter_strategy}.tsv",
    log:
        "<logs>/consolidate_names.{filter_strategy}.log",
    resources:
        slurm_account=config["account"],
    message:
        "Consolidating taxonomy based on GBIF matches"
    shell:
        """
        consolidate-names -i {input.coidb} -m {input.gbif} --filter_strategy {wildcards.filter_strategy} -o {output.tsv} >{log} 2>&1
        """


def consensus_input(wildcards):
    if wildcards.consensus_type == "coidb":
        return "<results>/coidb/coidb.info.tsv.gz"
    elif wildcards.consensus_type == "gbif.species-complete":
        return "<results>/consolidated/species-complete.tsv.gz"
    elif wildcards.consensus_type == "gbif.complete":
        return "<results>/consolidated/complete.tsv.gz"


# This rule calculates a consensus taxonomy for BOLD BINs. It uses as input
# both the BOLD data and the GBIF backbone. If BINs are present in the
# backbone this information takes precedence.
rule calculate_consensus:
    input:
        tsv=consensus_input,
    output:
        tsv=temp("<results>/consensus_taxonomy/{consensus_type}.{s}.tsv"),
    log:
        "<logs>/calculate_consensus.{consensus_type}.{s}.log",
    threads: 4
    resources:
        slurm_account=config["account"],
    params:
        ranks=config["ranks"],
        threshold=config["consensus_threshold"],
        method=config["consensus_method"],
        exclude_missing=lambda wildcards: (
            "--exclude_missing_data" if wildcards.s == "exclNA" else ""
        ),
    message:
        "Calculating consensus taxonomy for BINs"
    shell:
        """
        export POLARS_MAX_THREADS={threads}
        consensus-taxonomy -i {input.tsv} -o {output.tsv} \
            -r {params.ranks} -m {params.method} \
            {params.exclude_missing} -t {params.threshold} -p {threads} 2>{log}
        """


# BINs with more than 1 record are subject to clustering with vsearch. This
# checkpoint identifies all such BINs and prepares input for vsearch
# clustering. To avoid too large workflow graph, the BINs are grouped into
# batches with the batch size determined by the '--batch-size' command line
# argument.
checkpoint batch_multi_record_bins:
    input:
        tsv="<results>/coidb/coidb.info.tsv.gz",
    output:
        directory("<temp_dir>/_batch"),
    log:
        "<logs>/batch_multi_record_bins.log",
    threads: 4
    resources:
        slurm_account=config["account"],
    params:
        batch_size=config["batch_size"],
    shell:
        """
        exec &>{log}
        export POLARS_MAX_THREADS={threads}
        batch-split-bins -i {input.tsv} -o {output} -b {params.batch_size}
        ls {output}/*.fasta | while read f; do seqkit faidx --quiet $f; done
        """


# This rule clusters sequences for each batch of BOLD BINs.
rule vsearch:
    input:
        fasta="<temp_dir>/_batch/batch_{batch_id}.fasta",
    output:
        fasta=temp("<temp_dir>/_vsearch/batch_{batch_id}.fasta"),
    log:
        "<logs>/vsearch_logs/batch_{batch_id}.log",
    shadow:
        "minimal"
    threads: 4
    resources:
        slurm_account=config["account"],
    params:
        id=config["vsearch_identity"],
    message:
        "Clustering sequences in batch_{wildcards.batch_id}"
    shell:
        """
        exec &>{log}
        seqkit split \
            --by-id-prefix batch_{wildcards.batch_id}. \
            -O . -i --id-regexp "bin_uri:(BOLD:[A-Z0-9]+)" {input.fasta}
        for f in batch_{wildcards.batch_id}.*.fasta; 
        do 
            vsearch --cluster_fast $f --id {params.id} --centroids $f.centroids --threads {threads}
            rm $f
            cat $f.centroids | seqkit replace -p "\\|" -r " " >> {wildcards.batch_id}.fasta
        done
        mv {wildcards.batch_id}.fasta {output.fasta}
        """


def get_vsearch_fastas(wildcards):
    """
    This function globs all the 'batch_id' wildcards from the fasta files in the
    checkpoint_output directory.
    """
    checkpoint_output = checkpoints.batch_multi_record_bins.get(**wildcards).output[0]
    return expand(
        "{tempdir}/_vsearch/batch_{batch_id}.fasta",
        batch_id=glob_wildcards(
            os.path.join(checkpoint_output, "batch_{batch_id}.fasta")
        ).batch_id,
        tempdir=config["temp_dir"],
    )


# This rule concatenates all the vsearch clustered fasta files with
# single-record BIN fastas.
rule collect_vsearch:
    input:
        fasta=get_vsearch_fastas,
        tsv="<results>/coidb/coidb.info.tsv.gz",
    output:
        fasta="<results>/coidb/coidb.clustered.fasta.gz",
    log:
        "<logs>/collect_vsearch.log",
    shadow:
        "minimal"
    threads: 4
    resources:
        slurm_account=config["account"],
    message:
        "Collecting clustered and single-record BIN fastas"
    shell:
        """
        export POLARS_MAX_THREADS={threads}
        exec &>{log}
        bold2fasta -i {input.tsv} -o singles.fasta --single --low_memory
        cat {input.fasta} singles.fasta | seqkit seq -j {threads} -u -o {output.fasta}
        """


# Generate statistics on created database
rule stats:
    input:
        fasta=rules.collect_vsearch.output.fasta,
        tsv="<results>/coidb/coidb.info.tsv.gz",
        consensus="<results>/consensus_taxonomy/{consensus_type}.{s}.tsv.gz",
    output:
        "<results>/stats/{consensus_type}.{s}.txt",
    log:
        "<logs>/stats.{consensus_type}.{s}.log",
    threads: 1
    resources:
        slurm_account=config["account"],
    message:
        "Generating statistics"
    shell:
        """
        export POLARS_MAX_THREADS={threads}
        coidb-stats --tsv {input.tsv} --fasta {input.fasta} --consensus {input.consensus} > {output} 2>{log}
        """


def get_kv_format(wildcards):
    if wildcards.tool == "sintax":
        return "sintax"
    elif wildcards.tool == "dada2":
        if wildcards.format == "dada2.toGenus":
            return "dada2.toGenus"
        elif wildcards.format == "dada2.toSpecies":
            return "dada2.toSpecies"
        else:
            return "dada2.addSpecies"


rule generate_kv_file:
    input:
        tsv="<results>/consensus_taxonomy/{consensus_type}.{s}.tsv.gz",
        fasta=rules.collect_vsearch.output.fasta,
    output:
        txt=temp("<results>/{tool}/{format}.{consensus_type}.{s}.txt"),
        ids=temp("<results>/{tool}/{format}.{consensus_type}.{s}.ids"),
    log:
        "<logs>/generate_kv_file.{tool}.{format}.{consensus_type}.{s}.txt",
    threads: 1
    resources:
        slurm_account=config["account"],
    message:
        "Generate key-value file for {wildcards.tool} ({wildcards.format} {wildcards.consensus_type} {wildcards.s})"
    shell:
        """
        export POLARS_MAX_THREADS={threads}
        coidb-format --fasta {input.fasta} \
            --consensus {input.tsv} \
            --outfile {output.txt} \
            --idfile {output.ids} \
            --format {wildcards.format} 2>{log}
        """


def get_seqkit_pattern(wildcards):
    """
    Return the proper pattern string based on the fasta file format to produce
    """
    if wildcards.tool == "sintax" or wildcards.format == "dada2.addSpecies":
        return "' (.+)$'"
    elif wildcards.tool == "dada2":
        if wildcards.format in ["dada2.toGenus", "dada2.toSpecies"]:
            return "'.+ (.+)$'"


# This rule uses key-value files to generate sintax and dada2 formatted fasta
# files with seqkit.
rule format:
    input:
        kv_file=rules.generate_kv_file.output.txt,
        ids=rules.generate_kv_file.output.ids,
        fasta=rules.collect_vsearch.output.fasta,
    output:
        fasta="<results>/{tool}/{consensus_type}.{format}.{s}.fasta.gz",
    log:
        "<logs>/format_{tool}.{consensus_type}.{format}.{s}.log",
    threads: 4
    resources:
        slurm_account=config["account"],
    params:
        pattern=lambda wildcards: get_seqkit_pattern,
        replace=lambda wildcards: (
            " {kv}" if wildcards.format == "dada2.addSpecies" else "{kv}"
        ),
    message:
        "Generate {wildcards.tool} ({wildcards.consensus_type}/{wildcards.format}/{wildcards.s}) fasta files"
    shell:
        """
        exec &>{log}
        seqkit grep -j {threads} -f {input.ids} {input.fasta} | seqkit replace -j {threads} -p {params.pattern} -r '{params.replace}' -k {input.kv_file} -o {output.fasta}
        """


# This rule formats the tsv file for use with QIIME2 via qiime tools import
# --type 'FeatureData[Taxonomy]' --input-format TSVTaxonomyFormat
rule format_qiime2:
    input:
        fasta=rules.collect_vsearch.output.fasta,
        consensus="<results>/consensus_taxonomy/{consensus_type}.{s}.tsv.gz",
    output:
        temp("<results>/qiime2/{consensus_type}.qiime2.info.{s}.tsv"),
    log:
        "<logs>/format_qiime2.{consensus_type}.{s}.log",
    threads: 4
    resources:
        slurm_account=config["account"],
    message:
        "Generate QIIME2 compatible TSV file"
    shell:
        """
        export POLARS_MAX_THREADS={threads}
        coidb-format --fasta {input.fasta} --consensus {input.consensus} --format qiime2 --outfile {output} 2>{log}
        """
